# =============================================================================
# Investor Gate IT Operations Management System — Environment Configuration
# =============================================================================
# Copy this file to .env and replace all placeholder values before running.
# NEVER commit .env or private keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Runtime Mode
# -----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# -----------------------------------------------------------------------------
# PostgreSQL 16 Database & Least-Privilege Application Role
# -----------------------------------------------------------------------------
POSTGRES_DB=it_ops
POSTGRES_USER=postgres
DB_PASSWORD=replace-with-strong-postgres-superuser-password
APP_DB_USER=itops_app
APP_DB_PASSWORD=replace-with-strong-least-privilege-app-db-password

# -----------------------------------------------------------------------------
# FastAPI Backend Security & Session Configuration
# -----------------------------------------------------------------------------
# Must be at least 32 characters (64-char hex recommended):
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-cryptographic-random-hex-string
SESSION_EXPIRE_HOURS=24
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=["https://localhost","http://localhost:3000"]

# -----------------------------------------------------------------------------
# First-Time Bootstrap Admin Initialization (seed_data.py)
# -----------------------------------------------------------------------------
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@investorgate.sa
ADMIN_INITIAL_PASSWORD=replace-with-strong-initial-admin-password-min-12-chars
FORCE_ADMIN_PASSWORD_CHANGE=true

# -----------------------------------------------------------------------------
# HashiCorp Vault KV v2 (Zero-Plaintext Digital Assets Vault)
# -----------------------------------------------------------------------------
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT_POINT=secret
VAULT_DEV_MOCK=false

# -----------------------------------------------------------------------------
# Nginx Reverse Proxy Ports
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# SMTP Configuration (Optional — Password Recovery & Email Alerts)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Investor Gate OS"
FRONTEND_URL=https://localhost
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
